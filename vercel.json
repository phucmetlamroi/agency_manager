{
    "functions": {
        "api/*.py": {
            "maxDuration": 10
        },
        "src/app/api/**/*.ts": {
            "maxDuration": 30
        },
        "src/app/api/invoices/**/*.ts": {
            "maxDuration": 60
        },
        "src/app/api/review/uploads/**/*.ts": {
            "maxDuration": 60
        },
        "src/app/api/ent/uploads/**/*.ts": {
            "maxDuration": 60
        },
        "src/app/api/review/download-zip/route.ts": {
            "maxDuration": 300,
            "memory": 3009
        },
        "src/app/api/share/[token]/download-zip/route.ts": {
            "maxDuration": 300,
            "memory": 3009
        }
    },
    "crons": [
        {
            "path": "/api/cron/send-digest",
            "schedule": "0 * * * *"
        },
        {
            "path": "/api/cron/check-deadline",
            "schedule": "0 * * * *"
        },
        {
            "path": "/api/cron/cleanup-notifications",
            "schedule": "0 2 * * *"
        },
        {
            "path": "/api/cron/hard-delete-workspaces",
            "schedule": "0 3 * * *"
        },
        {
            "path": "/api/cron/hard-delete-profiles",
            "schedule": "30 3 * * *"
        },
        {
            "path": "/api/cron/auth-cleanup",
            "schedule": "0 4 * * *"
        },
        {
            "path": "/api/cron/review-janitor",
            "schedule": "0 20 * * *"
        },
        {
            "path": "/api/cron/billing-sweep",
            "schedule": "0 1 * * *"
        }
    ]
}