generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id        String   @id @default(uuid())
  name      String
  bannerUrl String?
  logoUrl   String?
  settings  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // [Sprint B] Trial/subscription columns dropped — tất cả profile đều free + full features.

  // [Sprint Z+1] Soft-delete pattern (match Workspace).
  // status: "ACTIVE" | "SOFT_DELETED". hardDeleteAfter set khi soft-delete (NOW + 30d).
  // Cron /api/cron/hard-delete-profiles xóa khi hardDeleteAfter <= now → cascade workspaces.
  status          String    @default("ACTIVE")
  deletedAt       DateTime?
  hardDeleteAfter DateTime?

  users               User[]
  workspaces          Workspace[]
  tasks               Task[]
  clients             Client[]
  projects            Project[]
  invoices            Invoice[]
  payrolls            Payroll[]
  bonuses             MonthlyBonus[]
  payrollLocks        PayrollLock[]
  metrics             PerformanceMetric[]
  agencies            Agency[]
  errorLogs           ErrorLog[]
  monthlyRanks        MonthlyRank[]
  scheduleRules       ScheduleRule[]
  scheduleExceptions  ScheduleException[]
  dailyAvailabilities DailyAvailability[]
  profileAccesses     ProfileAccess[]
  accessRequests      ProfileAccessRequest[] @relation("TargetProfileRequests")
  billingProfiles     BillingProfile[]
  tagCategories       TagCategory[]
  // [Bonus Config] 1 cấu hình thưởng / team (profile), dùng lại mọi tháng.
  bonusConfig         BonusConfig?
  // [Canonical Clients] Public client share links scoped to this profile.
  clientShareLinks    ClientShareLink[]

  @@index([status, deletedAt])
}

model Workspace {
  id              String   @id @default(uuid())
  name            String
  description     String?
  marketplaceOpen Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  profileId       String?

  // Soft-delete (Phase 1 multi-workspace plan, Chapter 3)
  // status defaults to ACTIVE; SOFT_DELETED workspaces hidden from switcher
  // until hard-delete cron after `hardDeleteAfter`.
  status          String    @default("ACTIVE") // see WorkspaceStatus enum: ACTIVE | SUSPENDED | SOFT_DELETED
  deletedAt       DateTime?
  hardDeleteAfter DateTime?

  members             WorkspaceMember[]
  invitations         WorkspaceInvitation[]
  tasks               Task[]
  clients             Client[]
  scheduleRules       ScheduleRule[]
  scheduleExceptions  ScheduleException[]
  dailyAvailabilities DailyAvailability[]
  projects            Project[]
  invoices            Invoice[]
  payrolls            Payroll[]
  bonuses             MonthlyBonus[]
  payrollLocks        PayrollLock[]
  metrics             PerformanceMetric[]
  // [Sprint A removed] feedbacks relation — Feedback model deleted
  errorLogs           ErrorLog[]
  monthlyRanks        MonthlyRank[]
  ratings             Rating[]
  sessions            Session[]
  auditLogs           AuditLog[]
  tagCategories       TagCategory[]

  // [Quick Create] OAuth tokens + pricing rules per-workspace
  integrationTokens IntegrationToken[]
  pricingRules      PricingRule[]

  // Wiki — standalone Notion-style doc tree
  wikiPages WikiPage[]

  // StudyPlace — per-user spaced repetition progress in Settings.
  studyPlaceProgress StudyPlaceProgress[]

  profile Profile? @relation(fields: [profileId], references: [id])

  @@index([name])
  @@index([status, deletedAt])
}

model WorkspaceMember {
  id          String   @id @default(uuid())
  userId      String
  workspaceId String
  role        String   @default("MEMBER") // see WorkspaceRole enum — kept as String until migration applied
  joinedAt    DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([userId])
  @@index([workspaceId])
}

model User {
  id                String    @id @default(uuid())
  username          String    @unique
  // [Username Handle] true = user đã chủ ý đặt username theo pattern mới
  // (signup mới hoặc đã complete migration modal). false = username cũ
  // (auto-derived từ email hoặc có dấu) → trigger migration modal khi user vào app.
  usernameSetByUser Boolean   @default(false)
  // [Google OAuth] password nullable — Google sign-in users have no password
  // (có thể đặt sau qua luồng "Quên mật khẩu"). googleId = Google account id
  // (canonical OAuth identity, dùng để nhận diện user quay lại). authProvider
  // = nguồn tạo tài khoản ("email" | "google") cho tracking/UI.
  password          String?
  googleId          String?   @unique
  authProvider      String?   @default("email")
  avatarUrl         String?
  createdAt         DateTime  @default(now())
  isTreasurer       Boolean   @default(false)
  hasAcceptedTerms  Boolean   @default(false)
  termsAcceptedAt   DateTime?
  email             String?
  nickname          String?
  phoneNumber       String?
  paymentAccountNum String?
  paymentBankName   String?
  paymentQrUrl      String?
  agencyId          String?
  profileId         String?
  role              UserRole  @default(USER)

  // ─── Auth Phase 1: signup / login email-only / forgot password ───
  // Display name (giữ Unicode tiếng Việt có dấu — KHÔNG sanitize)
  displayName                String?
  // Email verification flow
  emailVerified              Boolean   @default(false)
  emailVerifiedAt            DateTime?
  // Migration tracking cho user cũ (nhóm A/B/C trong backfill script)
  hasCompletedEmailMigration Boolean   @default(false)
  // Account lockout (5 fail / 15 phút)
  failedLoginAttempts        Int       @default(0)
  lockedUntil                DateTime?
  // Audit timestamps
  lastPasswordChangedAt      DateTime?
  lastLoginAt                DateTime?
  lastLoginIp                String?
  // Bump để invalidate tất cả JWT cũ (CVE-2025-29927 defense + reset password)
  sessionVersion             Int       @default(0)
  // Privacy: cho phép user thuộc Profile khác mời vào workspace của họ không?
  // Default true = backward compat. User có thể tắt trong Settings để chống
  // "spam invite từ unknown organizations" (audit finding #2.8).
  allowExternalInvites       Boolean   @default(true)
  // Audit fix #3.6: Link CLIENT-role user → Client record (portal access).
  // Trước đây client-portal-actions.ts match bằng `client.name === user.username`
  // → collision-prone. Giờ dùng FK explicit. Optional (Int?) cho user không phải CLIENT.
  clientId                   Int?
  client                     Client?   @relation("ClientPortalUser", fields: [clientId], references: [id], onDelete: SetNull)

  ownedAgency     Agency[]            @relation("AgencyOwner")
  bonuses         MonthlyBonus[]
  payrolls        Payroll[]
  metrics         PerformanceMetric[]
  tasks           Task[]              @relation("AssigneeTasks")
  // [Sprint P] Reverse relation for Task.assignedBy — track tasks user has
  // assigned to others (admin role). Used by email + notif routing.
  tasksAssignedBy Task[]              @relation("TaskAssigner")

  agency                   Agency?                 @relation("AgencyMembers", fields: [agencyId], references: [id])
  workspaces               WorkspaceMember[]
  clientTasks              Task[]                  @relation("UserClientTasks")
  clientProjects           Project[]               @relation("UserClientProjects")
  clientInvoices           Invoice[]               @relation("UserClientInvoices")
  clientRatings            Rating[]                @relation("ClientRatings")
  staffRatings             Rating[]                @relation("StaffRatings")
  errorLogs                ErrorLog[]              @relation("UserErrorLogs")
  detectedErrors           ErrorLog[]              @relation("UserDetectedErrors")
  monthlyRanks             MonthlyRank[]           @relation("UserMonthlyRanks")
  sessions                 Session[]
  events                   Event[]
  presence                 UserPresence?
  notificationPreference   NotificationPreference?
  scheduleRules            ScheduleRule[]
  scheduleExceptions       ScheduleException[]
  dailyAvailabilities      DailyAvailability[]
  profileAccesses          ProfileAccess[]
  accessRequests           ProfileAccessRequest[]
  approvedRequests         ProfileAccessRequest[]  @relation("ApprovedBy")
  requestedRequests        ProfileAccessRequest[]  @relation("RequestedBy")
  tagCategories            TagCategory[]
  auditLogsAsActor         AuditLog[]              @relation("AuditLogActor")
  auditLogsAsTarget        AuditLog[]              @relation("AuditLogUser")
  workspaceInvitesReceived WorkspaceInvitation[]   @relation("WorkspaceInvitedUser")
  workspaceInvitesSent     WorkspaceInvitation[]   @relation("WorkspaceInviter")

  // Auth Phase 1 relations
  emailVerificationTokens EmailVerificationToken[]
  passwordResetOTPs       PasswordResetOTP[]
  loginAttempts           LoginAttempt[]

  // [Quick Create] OAuth tokens for Dropbox / Google Drive per-user
  integrationTokens IntegrationToken[]

  // Contact relations
  contactsSent     Contact[]      @relation("ContactRequester")
  contactsReceived Contact[]      @relation("ContactReceiver")
  notifications    Notification[]

  // Wiki — authored standalone doc pages
  wikiPages WikiPage[]

  // StudyPlace — synchronized learning progress per workspace.
  studyPlaceProgress StudyPlaceProgress[]

  // [Canonical Clients] Share links this user created (profile OWNER/ADMIN only)
  shareLinksCreated ClientShareLink[] @relation("ShareLinkCreator")

  // [Trial P3] Web-push subscriptions (one per browser/device that opted in).
  pushSubscriptions PushSubscription[]

  profile Profile? @relation(fields: [profileId], references: [id])

  // Auth Phase 1 indexes
  @@index([email])
  @@index([lockedUntil])
}

// [Trial P3] A browser's Web Push subscription (endpoint + keys). One row per
// device that granted notification permission; pruned when the push service
// reports it gone (404/410). Sending is fully gated on VAPID env — no keys =
// nothing sent, table simply stays empty.
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model ProfileAccess {
  id        String      @id @default(uuid())
  userId    String
  profileId String
  // [Sprint Z] Role-based access per profile (replaces binary access model).
  // OWNER = profile creator with full quyền (incl. xóa member).
  // ADMIN = invited + promoted, can create workspace + invite, can't remove.
  // USER  = invited (default), read-only.
  role      ProfileRole @default(USER)
  // [Sprint Z] grantedAt also serves as cutoff for ADMIN workspace access:
  // ADMIN sees workspaces with createdAt >= grantedAt automatically. Older
  // workspaces need explicit WorkspaceMember row granted by Owner.
  grantedAt DateTime    @default(now())
  // [Client membership] When role=CLIENT, the Client record this membership represents.
  clientId  Int?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  client  Client? @relation("ProfileAccessClient", fields: [clientId], references: [id], onDelete: SetNull)

  @@unique([userId, profileId])
  // [Sprint Z] Indices to speed up role+cutoff queries
  @@index([userId, grantedAt])
  @@index([profileId, role])
}

model ProfileAccessRequest {
  id              String   @id @default(uuid())
  userId          String
  targetProfileId String
  requestedById   String
  approvedById    String?
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetProfile Profile @relation("TargetProfileRequests", fields: [targetProfileId], references: [id], onDelete: Cascade)
  requestedBy   User    @relation("RequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  approvedBy    User?   @relation("ApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([userId, targetProfileId])
}

model Payroll {
  id          String    @id @default(uuid())
  userId      String
  month       Int
  year        Int
  baseSalary  Decimal   @default(0)
  bonus       Decimal   @default(0)
  totalAmount Decimal
  status      String    @default("UNPAID")
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id])
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  profileId   String?
  profile     Profile?  @relation(fields: [profileId], references: [id])

  @@unique([userId, month, year, workspaceId], name: "userId_month_year_workspaceId")
}

model Task {
  id               String            @id @default(uuid())
  title            String
  deadline         DateTime?
  value            Decimal           @default(0)
  status           String            @default("Đang thực hiện")
  type             String            @default("Short form")
  references       String?
  resources        String?
  notes_vi         String?
  notes_en         String?
  fileLink         String?
  assigneeId       String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  productLink      String?
  isPenalized      Boolean           @default(false)
  exchangeRate     Decimal?          @default(25300)
  jobPriceUSD      Decimal?          @default(0)
  profitVND        Decimal?          @default(0)
  wageVND          Decimal?          @default(0)
  projectId        Int?
  clientId         Int?
  collectFilesLink String?
  submissionFolder String?
  frameUsername    String?
  framePassword    String?
  frameNote        String?           @default("Thông tin tài khoản frame dành cho trường hợp bạn bị out ra khỏi frame của team")
  assignedAgencyId String?
  version          Int               @default(0)
  invoiceId        String?
  invoiceStatus    InvoiceTaskStatus @default(UNBILLED)
  isArchived       Boolean           @default(false)
  // [Sprint A removed] feedbacks relation — Feedback model deleted
  errorLogs        ErrorLog[]
  invoiceItems     InvoiceItem[]
  assignedAgency   Agency?           @relation(fields: [assignedAgencyId], references: [id])
  assignee         User?             @relation("AssigneeTasks", fields: [assigneeId], references: [id])
  // [Canonical Clients 2026-06] Explicit SetNull — hard-deleting a client
  // must NEVER delete its tasks ("xóa client thì tasks vẫn còn"). Matches
  // the DB's existing behaviour for this optional FK; documented to prevent
  // drift.
  client           Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientUserId     String?
  clientUser       User?             @relation("UserClientTasks", fields: [clientUserId], references: [id])
  invoice          Invoice?          @relation(fields: [invoiceId], references: [id])
  project          Project?          @relation(fields: [projectId], references: [id])
  workspaceId      String?
  workspace        Workspace?        @relation(fields: [workspaceId], references: [id])
  profileId        String?
  profile          Profile?          @relation(fields: [profileId], references: [id])
  duration         String?
  // [Client Portal] Client-facing review state, decoupled from internal `status`.
  // null = not in client review · AWAITING = cut ready for client · APPROVED · CHANGES (client requested changes)
  clientReview     String?
  clientFeedback   String? // client's "request changes" note (separate from notes_vi)
  clientReviewedAt DateTime? // when the client last approved / requested changes
  claimSource      ClaimSource       @default(ADMIN)
  claimedAt        DateTime?
  taskTags         TaskTag[]
  rating           Rating?

  // [Sprint P] Track admin who assigned/created the task. Used for email +
  // in-app notification routing — when user starts/delivers a task, the
  // ASSIGNER (assignedBy) gets notified, not the user themselves.
  // Backward compat: nullable + onDelete: SetNull. Tasks created before
  // migration get backfilled to workspace OWNER.
  assignedById String?
  assignedBy   User?   @relation("TaskAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  // [Velox v4] Optional Multi-Hook Map persistence — see TaskRawFootage.
  // PER_LINK / BATCH legacy storage stays on `resources` / `references`.
  rawFootage TaskRawFootage?

  // [P0-pre 2026-07-03] Legacy column from the removed Cloudflare-Stream review
  // experiment. KEPT on purpose (additive-only: never ALTER Task); verified all
  // null in prod. The Mux review module (docs/review-module) links via
  // ReviewAsset.taskId instead — do not reuse this pointer.
  currentVersionId String?

  // [Client Task Submission v2] Client-submitted request(s) accepted into this
  // task (usually 0 or 1) — reverse side of ClientTaskRequest.task.
  clientTaskRequests ClientTaskRequest[] @relation("TaskClientRequests")

  // [Trial P1] ClickUp-style task comments (staff + client, visibility-gated).
  taskComments TaskComment[] @relation("TaskComments")

  @@index([workspaceId, status])
  @@index([workspaceId, isArchived])
  @@index([assignedById])
}

// [Velox v4 — Multi-Hook Map] Per-task display mode + persisted scan map.
// Existing tasks default to PER_LINK and don't get a TaskRawFootage row
// until the editor opts into BATCH or MULTI_HOOK_MAP on Add Task.
enum RawFootageDisplayType {
  PER_LINK
  BATCH
  MULTI_HOOK_MAP
}

model TaskRawFootage {
  id              String                @id @default(uuid())
  taskId          String                @unique
  task            Task                  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  displayType     RawFootageDisplayType @default(PER_LINK)
  // [MULTI_HOOK_MAP] Stores the user-edited VeloxScanResult as JSON. Schema
  // version + structure documented in src/lib/velox/v4-types.ts. Validated
  // server-side against Zod in src/actions/raw-footage-actions.ts.
  veloxMap        Json?
  // [HOOK_GRAPH] The user-built free-form node graph (the whiteboard). Distinct
  // from `veloxMap`, which is now only the Velox auto-scan used as an optional
  // SEED. Shape (HookGraph: blocks + edges + positions) documented in
  // src/lib/velox/hook-graph-types.ts and validated by Zod in
  // src/actions/raw-footage-actions.ts. Additive + nullable → zero data loss.
  manualGraph     Json?
  // Original Dropbox/Drive folder URL the user pasted. Used by the cache
  // layer (P5) to skip a re-scan when nothing on the folder changed.
  sourceFolderUrl String?
  scannedAt       DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([taskId])
}

model MonthlyBonus {
  id                 String    @id @default(uuid())
  userId             String
  month              Int
  year               Int
  rank               Int
  revenue            Decimal
  executionTimeHours Float
  bonusAmount        Decimal
  // [Bonus Config] % đã áp cho hạng này (snapshot config tại thời điểm tính).
  bonusPercent       Decimal?  @default(0)
  calculatedAt       DateTime  @default(now())
  user               User      @relation(fields: [userId], references: [id])
  workspaceId        String
  workspace          Workspace @relation(fields: [workspaceId], references: [id])
  profileId          String?
  profile            Profile?  @relation(fields: [profileId], references: [id])

  @@unique([userId, month, year, workspaceId], name: "userId_month_year_workspaceId")
}

model PayrollLock {
  id           String        @id @default(uuid())
  month        Int
  year         Int
  isLocked     Boolean       @default(false)
  lockedAt     DateTime      @default(now())
  lockedBy     String
  workspaceId  String
  workspace    Workspace     @relation(fields: [workspaceId], references: [id])
  profileId    String?
  profile      Profile?      @relation(fields: [profileId], references: [id])
  monthlyRanks MonthlyRank[]

  @@unique([month, year, workspaceId], name: "month_year_workspaceId")
}

model Client {
  id              Int             @id @default(autoincrement())
  name            String
  parentId        Int?
  aiScore         Decimal         @default(0)
  frictionIndex   Decimal         @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  inputQuality    Int             @default(3)
  paymentRating   Int             @default(3)
  tier            ClientTier      @default(standard)
  depositBalance  Decimal         @default(0)
  parent          Client?         @relation("ClientHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  subsidiaries    Client[]        @relation("ClientHierarchy")
  invoices        Invoice[]
  projects        Project[]
  tasks           Task[]
  // [Canonical Clients 2026-06] LEGACY — pre profile-scope. Clients are now
  // identified per-PROFILE (one canonical id, visible in every workspace of
  // the profile). Do NOT write workspaceId on new clients; it is retained
  // read-only on old + MERGED rows for forensics/rollback, and will be
  // dropped in a future cleanup migration.
  workspaceId     String?
  workspace       Workspace?      @relation(fields: [workspaceId], references: [id])
  profileId       String?
  profile         Profile?        @relation(fields: [profileId], references: [id])
  // Audit fix #3.6: Reverse relation cho User.clientId
  // Một Client record có thể có 0..N portal users (vd 1 client = nhiều người
  // truy cập portal cùng).
  portalUsers     User[]          @relation("ClientPortalUser")
  // [Client membership] CLIENT-role ProfileAccess rows that represent this client.
  profileAccesses ProfileAccess[] @relation("ProfileAccessClient")

  // [Quick Create] Per-client pricing rules (null clientId = workspace default)
  pricingRules PricingRule[]

  // [Canonical Clients] Public share links — admin-generated tokenized URLs
  // that let the client view their full history without an account.
  shareLinks ClientShareLink[]

  // [Client Task Submission v2] Work requests this client submitted via portal.
  clientTaskRequests ClientTaskRequest[] @relation("ClientTaskRequests")

  // [Soft-delete] Notion-style archive — mirror Profile/Workspace pattern.
  // status: "ACTIVE" | "SOFT_DELETED" | "MERGED".
  // - SOFT_DELETED: hidden from CRM lists/pickers, restorable from Client Trash.
  // - MERGED [Canonical Clients]: this row was a per-workspace duplicate that
  //   got absorbed into the canonical client (mergedIntoId). All FK rows
  //   (tasks/invoices/projects/...) were remapped to the survivor; this row
  //   keeps every original column (incl. legacy workspaceId) as the
  //   zero-data-loss rollback record. Never shown in any UI list.
  // hardDeleteAfter is reserved for a future auto-purge cron.
  status          String    @default("ACTIVE")
  deletedAt       DateTime?
  hardDeleteAfter DateTime?

  // [Canonical Clients] Merge pointer — set when status='MERGED'. Points at
  // the canonical survivor this duplicate was absorbed into.
  mergedIntoId Int?
  mergedInto   Client?  @relation("ClientMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom   Client[] @relation("ClientMerge")

  @@index([status, deletedAt])
  // Profile-wide reads (getClients, pickers) are the hot path post-migration.
  @@index([profileId, status])
}

/// [Canonical Clients 2026-06] Public share link — Google-Drive-style tokenized
/// URL that grants UNAUTHENTICATED access to one client's full task/invoice
/// history across every workspace of the profile.
///
/// Security model (mirrors EmailVerificationToken):
///   - The raw token (32 random bytes, base64url) is shown to the admin
///     EXACTLY ONCE at creation and never persisted. Only its SHA-256 hex
///     lives here — a DB leak does not leak working links.
///   - Lookup is by tokenHash; revoked/expired/merged-client all resolve to
///     the same uniform 404 (no enumeration oracle).
///   - Only profile OWNER/ADMIN can create/revoke (canManageShareLinks).
model ClientShareLink {
  id          String    @id @default(uuid())
  tokenHash   String    @unique
  clientId    Int
  profileId   String
  createdById String?
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?
  /// null = link sống vĩnh viễn (admin thu hồi thủ công).
  expiresAt   DateTime?

  // Access telemetry — surfaced in the admin ShareLink panel.
  lastAccessedAt DateTime?
  accessCount    Int       @default(0)

  // [Video Review] Per-link capability toggles (Frame.io "Link Settings").
  // Defaults keep existing links fully-capable; an admin can issue a
  // view-only / no-approve / latest-version-only link. `passphraseHash` gates
  // the portal before any Stream signed token is minted (null = no passphrase).
  allowVideoComments Boolean @default(true)
  allowDownload      Boolean @default(false)
  showAllVersions    Boolean @default(true)
  canApprove         Boolean @default(true)
  passphraseHash     String?

  // [Phase C] Client-managed notification email (portal Settings page). The client enters an
  // email, verifies it with a 6-digit OTP, and it persists here until they change/remove it.
  // Review-status emails are fanned out to it (see guest-notify). All fields null = not set.
  notifyEmail              String?
  notifyEmailVerifiedAt    DateTime?
  notifyEmailPending       String? // email awaiting OTP verification (not yet the live one)
  notifyEmailCodeHash      String? // SHA-256 of the pending 6-digit OTP
  notifyEmailCodeExpiresAt DateTime?
  notifyEmailUnsubToken    String?   @unique // one-click List-Unsubscribe token for notify emails

  client    Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("ShareLinkCreator", fields: [createdById], references: [id], onDelete: SetNull)

  // Ratings submitted through this link (no user account involved).
  ratings Rating[]

  @@index([clientId])
  @@index([profileId, revokedAt])
}

/// [Client Task Submission v2] A client-submitted work request — the token-portal
/// intake, DISTINCT from a Task. The client fills the 5-step wizard; this row is
/// created (status NEW) and every profile OWNER/ADMIN is emailed. An admin reviews
/// it in the "Hộp thư yêu cầu" inbox and, on accept, spawns a real Task (taskId
/// set); a reject keeps rejectionNote for the trail. Carries NO finance/assignee/
/// frame fields — those never touch the token portal. Not a bypass model, so
/// getWorkspacePrisma injects both profileId + workspaceId on admin-side reads.
enum ClientRequestStatus {
  NEW
  REVIEWING
  ACCEPTED
  REJECTED
}

model ClientTaskRequest {
  id           String @id @default(uuid())

  // Tenancy — both required; the token action sets them explicitly from the
  // resolved share-link scope (never from client input).
  profileId      String
  workspaceId    String
  clientId       Int?
  viaShareLinkId String?
  submittedVia   String  @default("SHARE_LINK") // SHARE_LINK | ACCOUNT

  // Payload — mirrors the client wizard fields (video list + the 6 asset links +
  // brief). No jobPriceUSD/wage/assignee/frame — leak discipline.
  title           String
  videoList       String?   @db.Text // newline-separated video names
  desiredType     String? // "Short form" | "Long form" | "Trial" hint
  desiredDeadline DateTime?
  rawFootage      String?
  collectFile     String?
  bRoll           String?
  refs            String? // reference link (avoid clashing name with Task.references)
  submitFolder    String?
  script          String?
  notes           String?   @db.Text

  // Lifecycle
  status        ClientRequestStatus @default(NEW)
  reviewedById  String?
  reviewedAt    DateTime?
  rejectionNote String?
  taskId        String? // set on accept — links the spawned Task

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Client hard-delete must not delete request history (mirror Task.clientId).
  client Client? @relation("ClientTaskRequests", fields: [clientId], references: [id], onDelete: SetNull)
  task   Task?   @relation("TaskClientRequests", fields: [taskId], references: [id], onDelete: SetNull)

  @@index([workspaceId, profileId, status])
  @@index([clientId, status])
  @@index([viaShareLinkId])
}

