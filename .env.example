# ── [Review module · Mux + R2 + Inngest] (docs/review-module — KIEN-TRUC §5.3) ──
# Thêm đủ bộ này vào Vercel (Production + Preview + Development). KHÔNG commit giá trị thật.

# Cloudflare R2 — bucket `hustly-review`, location hint APAC, CORS phải có ExposeHeaders:["ETag"]
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=hustly-review

# Mux — Access Token (Mux Video Read+Write) + webhook + signing key pair (signed playback)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=   # base64 PEM (Mux trả về sẵn dạng base64, ~2200 ký tự)

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Module review
REVIEW_COOKIE_SECRET=      # 32+ bytes random (vd: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
# CRON_SECRET + NEXT_PUBLIC_APP_URL: đã tồn tại sẵn trong env của app — không thêm lại.
